{
  "name": "@osspkg/asphalt-ui",
  "version": "0.1.2",
  "license": "BSD-3-Clause",
  "author": "Mikhail Knyazhev <markus621@yandex.com>",
  "description": "Small, composable React UI primitives and page patterns.",
  "repository": {
    "type": "git",
    "url": "https://github.com/osspkg/react-asphalt-ui.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "DESIGN.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/index.css"
  },
  "peerDependencies": {
    "lucide-react": "^0.468.0",
    "react": ">=18",
    "react-dom": ">=18",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config vite.demo.config.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run typecheck && npm run build"
  }
}
